# ── Phase 2: real LLM (Google Gemini, free tier) ───────────────────────────────
# 1. Get a free key:  https://aistudio.google.com/apikey
# 2. Copy this file to  .env.local  and paste your key below.
# 3. Run the agent API:  npm run api    (then `npm run dev` in another terminal)
#
# .env.local is gitignored — the key stays SERVER-SIDE (in api/) and never enters
# the browser bundle. Without a key, /api/agent still works, returning deterministic
# (mock-style) answers, and the UI also falls back to the offline mock if the API is down.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Optional: change the local agent server port (must match the Vite proxy in vite.config.js).
# API_PORT=8787
